# Copy to .env and fill in. .env is gitignored. Everything here is optional unless marked required.

# Required for live commentary: Kimi model id on Cerebras (baked into the extension at build time)
CEREBRAS_KIMI_MODEL=
# Cerebras API key, read by the Node tools (llm:calibrate, llm:soak, director:live, bridge:dry); the extension takes its key in the popup
CEREBRAS_API_KEY=

# Optional: GPU baseline for the speed race (build time; key is entered in the popup)
GPU_BASELINE_MODEL=
GPU_BASELINE_PROVIDER=

# Optional bridge (tools/bridge): shared secret, must match between the extension build and the bridge
BRIDGE_TOKEN=
# Optional bridge: URL the extension posts to (default http://127.0.0.1:8787)
BRIDGE_URL=
# Optional bridge: Telegram bot token and target chat for analyst pings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional bridge: OpenClaw agent hook
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=
